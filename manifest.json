{
  "manifest_version": 3,
  "name": "网申自动填写助手",
  "version": "1.3.7",
  "description": "简历字段库 + 短字段一键自动填 + 长文本点选填 + AI 开放题起草 + 投递台账。数据只存本机。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "网申自动填写助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "https://open.bigmodel.cn/*",
    "https://api.deepseek.com/*",
    "https://api.moonshot.cn/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.openai.com/*",
    "https://api.siliconflow.cn/*",
    "https://openrouter.ai/*",
    "http://*/*",
    "https://*/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "data/templates.js",
        "data/field-matching.js",
        "data/fill-contract.js",
        "data/fill-result.js",
        "data/applications.js",
        "content/field-adapters.js",
        "content/field-scanner.js",
        "content/fill-session.js",
        "content/detector.js",
        "content/filler.js",
        "content/controls/verification.js",
        "content/controls/text.js",
        "content/controls/native.js",
        "content/controls/date-phone.js",
        "content/controls/dropdown.js",
        "content/controls/address.js",
        "content/controls/registry.js",
        "content/verified-fill.js",
        "content/page-presence.js",
        "content/job-recognizer.js",
        "content/floatbar.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [{
    "resources": ["panel/panel.html"],
    "matches": ["http://*/*", "https://*/*"]
  }]
}
